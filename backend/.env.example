# Copy to backend/.env. Keep real credentials in that ignored file only.
ASSEMBLYAI_API_KEY=your_assemblyai_api_key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

AMD_VISION_ENABLED=true
AMD_TOKEN_FACTORY_API_KEY=your_amd_token_factory_api_key
AMD_TOKEN_FACTORY_BASE_URL=https://developer.amd.com.cn/radeon/api/v1
AMD_VISION_MODEL=your_exact_vision_capable_model_id
AMD_VISION_MAX_DIMENSION=1280
AMD_VISION_JPEG_QUALITY=85

EVOLUS_ENABLED=true
EVOLUS_API_KEY=your_evolus_application_api_key
EVOLUS_APPLICATION_ID=your_workspace_application_id
EVOLUS_AGENT_ID=your_echosight_agent_id
# Origin only; client appends /v1 for the documented agent-chat endpoint.
EVOLUS_BASE_URL=https://api.evolus.ai

ECHOSIGHT_NAVIGATION_MAX_AGE_SECONDS=5
ECHOSIGHT_DESCRIPTION_MAX_AGE_SECONDS=30
ECHOSIGHT_UPLOAD_MAX_AGE_SECONDS=600
ECHOSIGHT_SESSION_TTL_SECONDS=1800
ECHOSIGHT_INFERENCE_QUEUE_TIMEOUT_SECONDS=5
# Enable only after replacing vision/metric_depth.py calibration points
# with measurements from the actual camera. Relative depth is not meters.
ECHOSIGHT_METRIC_DEPTH_ENABLED=false
